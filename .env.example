APP_NAME="Chanel Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
MCP_OAUTH_REDIRECT_DOMAINS=https://chatgpt.com,https://chat.openai.com
MCP_OAUTH_CUSTOM_SCHEMES=
LORA_PLATFORM_BILLING_DUE_DAYS=14
FATURE_AL_ONBOARDING_TOKEN=
FATURE_AL_APP_NAME=LoraPMS
FATURE_AL_BUILD_VERSION=dev

APP_LOCALE=sq
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Europe/Tirane

LORA_CONTROL_PANEL_URL=https://admin.lorapms.com
LORA_CONTROL_PANEL_HOSTS=admin.lorapms.com,admin.staging.lorapms.com,staging.lorapms.com
LORA_DEDICATED_CONTROL_PANEL_HOSTS=admin.lorapms.com,admin.staging.lorapms.com
LORA_MARKETING_HOSTS=lorapms.com,www.lorapms.com,staging.lorapms.com
LORA_ADDITIONAL_TRUSTED_HOSTS=
LORA_TRUSTED_HOSTS_CACHE_SECONDS=60
LORA_TENANT_HANDOFF_TTL_SECONDS=60

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=chanel_manager
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime (task #52): 'reverb' në server (daemon reverb:start pas nginx /app);
# lokalisht pa Reverb të ndezur mund të përdorësh 'log'.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Backend-i (Laravel → Reverb) flet lokalisht me daemon-in:
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Daemon-i dëgjon vetëm localhost — bota hyn përmes nginx /app (wss 443):
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST lihet BOSH me qëllim: browseri lidhet te hosti i faqes
# aktuale (multi-tenant — çdo domain hoteli kalon te i njëjti Reverb).
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Channex.io channel manager (OTA sync). Get the API key from the Channex
# dashboard: avatar (top-right) -> Profile -> API Keys -> Create. The key goes
# here only (never committed). While PILOTING, point base_url at the sandbox:
#   CHANNEX_BASE_URL=https://staging.channex.io/api/v1
# Leave it unset for production (defaults to https://app.channex.io/api/v1).
CHANNEX_API_KEY=
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_PROPERTY_ID=
# Match Channex Property Settings -> Inventory Days (default 500, max 730).
CHANNEX_STATE_LENGTH_DAYS=500
# Shared secret for the inbound booking webhook. MUST match the value registered
# in the Channex webhook 'headers'. If empty, the webhook endpoint is DISABLED
# (fail-closed) — set it before connecting an OTA so bookings can flow in.
CHANNEX_WEBHOOK_SECRET=

# Laravel Forge - automatic hotel domain provisioning (site + SSL).
# server_ip is what customer DNS must point at; app_root is the shared app
# document root on that server. Leave token empty to disable provisioning.
FORGE_API_TOKEN=
FORGE_SERVER_ID=
FORGE_SERVER_IP=
FORGE_APP_ROOT=
FORGE_SITE_USER=lorapms
